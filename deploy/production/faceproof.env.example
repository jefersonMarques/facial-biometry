# FaceProof Production Candidate
FACEPROOF_ENV=production

# Internal listeners. Production validation refuses wildcard/public API binds.
FACEPROOF_API_ADDR=127.0.0.1:8180

# Public HTTPS origin terminated by Caddy.
FACEPROOF_ALLOWED_ORIGIN=https://faceproof.example.com
FACEPROOF_IDENTITY_VERIFY_URL=https://faceproof.example.com/verify.html

# Runtime secrets. Generate unique high-entropy values and protect this file as 0640 root:faceproof.
FACEPROOF_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FACEPROOF_TEMPLATE_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
FACEPROOF_ADMIN_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Commercial tenant registry. Do not configure a legacy shared issuer key in production.
FACEPROOF_TENANT_REGISTRY=/etc/faceproof/tenants.json
FACEPROOF_IDENTITY_ISSUER_KEY=

# Encrypted persistent state.
FACEPROOF_TEMPLATE_DIR=/var/lib/faceproof/templates
FACEPROOF_IDENTITY_DIR=/var/lib/faceproof/identity-checks

# Native Secure Core and signed Model Pack.
FACEPROOF_SECURE_CORE_LIBRARY=/opt/faceproof/lib/libfaceproof_core.so
FACEPROOF_MODEL_PACK=/opt/faceproof/models/faceproof-standard.fpmp
FACEPROOF_MODEL_PACK_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY
FACEPROOF_MODEL_PACK_CACHE_DIR=/var/lib/faceproof/model-cache

# Biometric policy.
FACEPROOF_SESSION_TTL_SECONDS=120
FACEPROOF_MATCH_THRESHOLD=0.363
FACEPROOF_LIVENESS_THRESHOLD=0.68
FACEPROOF_REVIEW_LIVENESS_THRESHOLD=0.55
FACEPROOF_ALLOW_REVIEW_ENROLLMENT=false
FACEPROOF_REQUIRE_PASSIVE_PAD=true
FACEPROOF_IDENTITY_LINK_TTL_MINUTES=60
FACEPROOF_IDENTITY_MAX_PDF_MB=8

# Runtime fingerprint. Pin these to the deployed browser artifacts.
FACEPROOF_RUNTIME_SDK_VERSION=0.3.0
FACEPROOF_RUNTIME_LIVENESS_CORE_VERSION=0.1.0
FACEPROOF_RUNTIME_LIVENESS_WASM_SHA256=REPLACE_WITH_DEPLOYED_WASM_SHA256
FACEPROOF_RUNTIME_MEDIAPIPE_VERSION=1.0.1

# Optional external PostgreSQL analytics. Analytics remains fail-open and is not quota authority.
FACEPROOF_ANALYTICS_DATABASE_URL=
