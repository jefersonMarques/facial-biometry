[Unit]
Description=FaceProof Admin Gateway
After=faceproof-api.service
Requires=faceproof-api.service

[Service]
Type=simple
User=faceproof
Group=faceproof
WorkingDirectory=/opt/faceproof
Environment=FACEPROOF_ENV=production
Environment=FACEPROOF_WEB_ADDR=127.0.0.1:5174
Environment=FACEPROOF_DEV_API_URL=http://127.0.0.1:8180
Environment=FACEPROOF_WEB_DIR=/opt/faceproof/web/admin
ExecStart=/opt/faceproof/bin/faceproof-web-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/faceproof

[Install]
WantedBy=multi-user.target
