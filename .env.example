FACEPROOF_ENV=development
FACEPROOF_API_ADDR=:8180
FACEPROOF_SECURE_CORE_LIBRARY=/opt/faceproof/lib/libfaceproof_core.so
FACEPROOF_MODEL_PACK=/opt/faceproof/models/faceproof-standard.fpmp
FACEPROOF_MODEL_PACK_PUBLIC_KEY=replace-with-base64-ed25519-public-key
FACEPROOF_MODEL_PACK_CACHE_DIR=/var/lib/faceproof/model-cache

# Python development/R&D fallback only.
FACEPROOF_ENGINE_URL=http://127.0.0.1:8090
FACEPROOF_ENGINE_ADDR=127.0.0.1
FACEPROOF_ENGINE_PORT=8090
FACEPROOF_ALLOWED_ORIGIN=http://localhost:5173
FACEPROOF_SESSION_SECRET=replace-with-at-least-32-random-characters
FACEPROOF_TEMPLATE_KEY=replace-with-base64-encoded-32-byte-key
FACEPROOF_TEMPLATE_DIR=../../data/templates
FACEPROOF_SESSION_TTL_SECONDS=120
FACEPROOF_MATCH_THRESHOLD=0.363
FACEPROOF_LIVENESS_THRESHOLD=0.68
FACEPROOF_REVIEW_LIVENESS_THRESHOLD=0.55
FACEPROOF_ALLOW_REVIEW_ENROLLMENT=false
FACEPROOF_REQUIRE_PASSIVE_PAD=true

FACEPROOF_IDENTITY_ISSUER_KEY=replace-with-at-least-32-random-characters
FACEPROOF_IDENTITY_DIR=../../data/identity-checks
FACEPROOF_IDENTITY_VERIFY_URL=http://localhost:5173/verify.html
FACEPROOF_IDENTITY_LINK_TTL_MINUTES=60
FACEPROOF_IDENTITY_MAX_PDF_MB=8
FACEPROOF_PDFSIG_PATH=
FACEPROOF_PDFINFO_PATH=
FACEPROOF_BPGDEC_PATH=

# Loose model paths are used only by Python R&D/build tooling.
FACEPROOF_YUNET_MODEL=../../models/yunet/face_detection_yunet_2023mar.onnx
FACEPROOF_SFACE_MODEL=../../models/sface/face_recognition_sface_2021dec.onnx
FACEPROOF_MINIFASNET_MODEL=../../models/minifasnet/MiniFASNetV2.onnx
